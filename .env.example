OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional per-stage model overrides. Leave blank to use OPENAI_MODEL.
OPENAI_EXTRACT_MODEL=gpt-5.4-nano
OPENAI_RANK_PUBLISHERS_MODEL=
OPENAI_SELECT_PERSONAS_MODEL=
OPENAI_EXECUTION_MODEL=
OPENAI_REPAIR_MODEL=gpt-5.4-nano

# Optional speed and quality controls. Blank shared values use code defaults.
OPENAI_SERVICE_TIER=
OPENAI_REASONING_EFFORT=
OPENAI_MAX_OUTPUT_TOKENS=

OPENAI_EXTRACT_REASONING_EFFORT=none
OPENAI_RANK_PUBLISHERS_REASONING_EFFORT=none
OPENAI_SELECT_PERSONAS_REASONING_EFFORT=none
OPENAI_EXECUTION_REASONING_EFFORT=none
OPENAI_REPAIR_REASONING_EFFORT=none

OPENAI_EXTRACT_MAX_OUTPUT_TOKENS=800
OPENAI_RANK_PUBLISHERS_MAX_OUTPUT_TOKENS=2000
OPENAI_SELECT_PERSONAS_MAX_OUTPUT_TOKENS=2200
OPENAI_EXECUTION_MAX_OUTPUT_TOKENS=3000
OPENAI_REPAIR_MAX_OUTPUT_TOKENS=1800
