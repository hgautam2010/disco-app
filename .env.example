OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Optional per-stage model overrides. Leave blank to use OPENAI_MODEL.
OPENAI_EXTRACT_MODEL=gpt-5.6-luna
OPENAI_RANK_PUBLISHERS_MODEL=
OPENAI_SELECT_PERSONAS_MODEL=
OPENAI_EXECUTION_MODEL=
OPENAI_REPAIR_MODEL=gpt-5.6-luna

# Optional speed and quality controls. Blank shared values use code defaults.
OPENAI_SERVICE_TIER=
OPENAI_REASONING_EFFORT=
OPENAI_MAX_OUTPUT_TOKENS=

OPENAI_EXTRACT_REASONING_EFFORT=none
OPENAI_RANK_PUBLISHERS_REASONING_EFFORT=low
OPENAI_SELECT_PERSONAS_REASONING_EFFORT=low
OPENAI_EXECUTION_REASONING_EFFORT=low
OPENAI_REPAIR_REASONING_EFFORT=none

OPENAI_EXTRACT_MAX_OUTPUT_TOKENS=1000
OPENAI_RANK_PUBLISHERS_MAX_OUTPUT_TOKENS=2600
OPENAI_SELECT_PERSONAS_MAX_OUTPUT_TOKENS=2600
OPENAI_EXECUTION_MAX_OUTPUT_TOKENS=3600
OPENAI_REPAIR_MAX_OUTPUT_TOKENS=2200

# Required vector retrieval.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_PUBLISHERS_COLLECTION=disco_publishers
QDRANT_PERSONAS_COLLECTION=disco_personas
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
